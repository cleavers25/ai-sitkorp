# Copy to .env and fill in every value. Never commit .env.
#
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                      # JWT_SECRET / passwords
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"  # SECRET_MASTER_KEY
#
# SECRET_MASTER_KEY encrypts every stored credential. Back it up separately from the
# database: losing it makes all stored SSH keys and API keys unrecoverable.

POSTGRES_USER=aiinfra
POSTGRES_PASSWORD=
POSTGRES_DB=aiinfra
REDIS_PASSWORD=

JWT_SECRET=
SECRET_MASTER_KEY=

# First admin account, created only when the users table is empty.
# Remove these after the first login and change the password in the UI.
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=

# Hostname users will open in the browser (e.g. aiinfra.internal). Multiple
# domains can be listed, separated by comma+space (e.g. a.example.com, b.example.com).
# Opening by raw IP does not work in browsers (no SNI is sent for IP addresses).
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
COOKIE_SECURE=true

# Public URL of this app; used for "Buka:" links in email/webhook/Telegram notifications.
APP_BASE_URL=https://localhost
